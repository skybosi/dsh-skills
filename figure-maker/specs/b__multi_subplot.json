    "color": "#EF4444"
   },
   {
    "func": "exp(-0.3*x)",
    "x_min": 0,
    "x_max": 15,
    "title": "平稳序列 ACF：快速衰减到 0",
    "color": "#3B82F6"
   },
   {
    "func": "1.0 / (1 + 0.1*x)",
    "x_min": 0,
    "x_max": 15,
    "title": "非平稳序列 ACF：缓慢衰减",
    "color": "#EF4444"
   }
  ]
 }
}