{
 "id": "service_layers",
 "type": "block_diagram",
 "output": "out/service_layers.svg",
 "params": {
  "title": "订单系统分层架构（同步链路 + 异步链路 + 跨列调用）",
  "blocks": [
   {
    "id": "cli",
    "row": 0,
    "col": 0,
    "label": "客户端",
    "shape": "text"
   },
   {
    "id": "gw",
    "row": 1,
    "col": 0,
    "label": "API 网关",
    "role": "block"
   },
   {
    "id": "svc",
    "row": 2,
    "col": 0,
    "label": "订单服务",
    "role": "ffn"
   },
   {
    "id": "mq",
    "row": 1,
    "col": 1,
    "label": "消息队列 Kafka",
    "role": "project"
   },
   {
    "id": "wk",
    "row": 2,
    "col": 1,
    "label": "履约 Worker",
    "role": "ffn"
   },
   {
    "id": "db",
    "row": 3,
    "col": 0,
    "span": 2,
    "label": "MySQL（主库 / 只读从库）",
    "role": "embedding"
   }
  ],
  "edges": [
   {
    "from": "cli",
    "to": "gw"
   },
   {
    "from": "gw",
    "to": "svc"
   },
   {
    "from": "svc",
    "to": "db"
   },
   {
    "from": "svc",
    "to": "mq",
    "from_side": "right",
    "to_side": "left",
    "label": "发消息"
   },
   {
    "from": "mq",
    "to": "wk"
   },
   {
    "from": "wk",
    "to": "db"
   }
  ],
  "frames": [
   {
    "col": 0,
    "rows": [
     1,
     2
    ],
    "label": "同步链路",
    "label_side": "left"
   },
   {
    "col": 1,
    "rows": [
     1,
     2
    ],
    "label": "异步链路",
    "label_side": "right"
   }
  ]
 }
}